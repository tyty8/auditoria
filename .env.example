# --- Required ---
# Neon PostgreSQL connection string
DATABASE_URL=

# Master admin password for the login form (always logs in with role "admin")
ADMIN_PASSWORD=

# Long random string used to sign session cookies (changing it revokes all sessions)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# --- Optional ---
# Allows POST /api/seed to reset demo data
ALLOW_SEED=

# Resend API key — enables invitation emails, reminders and weekly digests
RESEND_API_KEY=

# Verified sender for outgoing email, e.g. "Auditoría <hola@tudominio.com>"
EMAIL_FROM=

# Public base URL used in email links (falls back to the request origin / Vercel URL)
APP_URL=

# Shared secret for Vercel Cron endpoints (/api/cron/*). Vercel sets the
# Authorization: Bearer header automatically when this env var exists.
CRON_SECRET=
